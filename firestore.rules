rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; 
    }

    // 1. Users Collection
    match /users/{userId} {
      // Temporarily permissive due to server-side Client SDK usage without custom tokens
      allow read, write: if true;
    }

    // 2. ERP Orders
    match /erp_orders/{orderId} {
      allow read, write: if true; // Allow for now until we handle frontend auth properly
    }

    // 3. Daily Logs
    match /daily_logs/{logId} {
      allow read, write: if true;
    }

    // 4. Audit Logs
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
    }
    
    // 5. Buyer Data Bank
    match /buyer_data_bank/{recordId} {
      allow read, write: if true;
    }
  }
}
